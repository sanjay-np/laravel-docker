#!/bin/bash

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check if the app container is running
if [ ! "$(docker ps -q -f name=laravel_app)" ]; then
    echo "Error: laravel_app container is not running."
    echo "Please start the containers with: docker compose up -d"
    exit 1
fi

# If the first argument is a directory in src/, assume we want to run pint there
if [ -d "$SCRIPT_DIR/../src/$1" ] && [ -f "$SCRIPT_DIR/../src/$1/vendor/bin/pint" ]; then
    PROJECT=$1
    shift
    docker compose exec -u laravel app bash -c "cd $PROJECT && vendor/bin/pint $*"
else
    docker compose exec -u laravel app vendor/bin/pint $@
fi
